{
  "name": "my-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vuepress dev docs --host 127.0.0.1",
    "build": "vuepress build docs",
    "serve": "node scripts/serve.mjs",
    "typecheck": "vue-tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "notes:check": "node scripts/notes.mjs check",
    "notes:format": "node scripts/notes.mjs format",
    "notes:test": "node --test scripts/notes.test.mjs"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "$katex"
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vuepress/bundler-vite": "2.0.0-rc.31",
    "@vuepress/plugin-slimsearch": "2.0.0-rc.137",
    "cheerio": "1.2.0",
    "katex": "0.18.10",
    "markdownlint": "0.41.1",
    "prettier": "3.9.10",
    "sass-embedded": "1.105.0",
    "typescript": "~6.0.2",
    "vue": "3.5.43",
    "vue-tsc": "^3.1.0",
    "vuepress": "2.0.0-rc.31",
    "vuepress-theme-hope": "2.0.0-rc.110",
    "yaml": "2.9.1"
  }
}
